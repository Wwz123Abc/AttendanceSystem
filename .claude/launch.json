{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "attendance-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "AttendanceSystem.csproj",
        "-p:StaticWebAssetsEnabled=false",
        "--",
        "--urls=http://localhost:50721",
        "--environment=Development"
      ],
      "port": 50721
    },
    {
      "name": "attendance-verify",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "AttendanceSystem.csproj",
        "-p:StaticWebAssetsEnabled=false",
        "--",
        "--urls=http://localhost:50722",
        "--environment=Development"
      ],
      "port": 50722,
      "env": {
        "ConnectionStrings__Default": "Server=localhost;Port=3306;Database=AttendanceDB_verify;User=root;Password=root1234;CharSet=utf8mb4;AllowPublicKeyRetrieval=true;SslMode=None;"
      }
    }
  ]
}