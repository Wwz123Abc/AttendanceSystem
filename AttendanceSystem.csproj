<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Nullable / ImplicitUsings / LangVersion 等通用设置在仓库根目录的 Directory.Build.props 里统一配置 -->
    <RootNamespace>AttendanceSystem</RootNamespace>
    <AssemblyName>AttendanceSystem</AssemblyName>
    <!-- 嵌套的 AppBoxCore.EFCore、AttendanceSystem.Tests 都是独立项目，不应被本项目当成源码编译进来 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);AppBoxCore.EFCore\**;AttendanceSystem.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core 9.0.9 + MariaDB/MySQL（Pomelo 9.0.0）-->
    <PackageReference Include="AlibabaCloud.SDK.Facebody20191230" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />

    <!-- Excel 导出 -->
    <PackageReference Include="NPOI" Version="2.7.5" />
    <!-- NPOI 2.7.5 间接依赖的 System.Security.Cryptography.Xml 8.0.2 有已知高危漏洞，这里直接引用已修复的版本压过去（我们只用 NPOI 导出 Excel，用不到这块功能） -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />

    <!-- 日志 -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
