@page
@model AttendanceSystem.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "修改密码"; }

<div class="page-header">
    <h4><i class="bi bi-key me-2 text-primary"></i>修改密码</h4>
</div>

<div class="alert alert-info">
    <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i>修改前请先看这里</div>
    <ul class="mb-0 ps-3 small">
        <li>新密码至少 <b>6 位</b>，建议字母+数字组合，不要用生日、工号、手机号这类容易被猜到的密码。</li>
        <li>第一次用初始密码 <b>123456</b> 登录、或被管理员重置密码后，系统会要求你先改密码。</li>
        <li>改完请记住新密码；忘记了只能找文员/管理员重置。</li>
        <li>不要把密码告诉同事，一人一号，共用账号会导致打卡记录算到别人头上。</li>
    </ul>
</div>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body p-4">
                @if (Model.Forced && string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>您当前使用的是初始/重置密码，请先修改成自己的密码后再继续使用系统。
                    </div>
                }
                @if (Model.ShowSuccess)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle me-2"></i>密码修改成功！请下次登录时使用新密码。
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-x-circle me-2"></i>@Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">当前密码</label>
                        <input asp-for="OldPassword" type="password" class="form-control" required placeholder="请输入当前密码" autocomplete="current-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">新密码</label>
                        <input asp-for="NewPassword" type="password" class="form-control" required minlength="6" placeholder="至少 6 位" autocomplete="new-password" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">确认新密码</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" required minlength="6" placeholder="再次输入新密码" autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check-lg me-2"></i>确认修改
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
