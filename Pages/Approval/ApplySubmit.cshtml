@page
@model AttendanceSystem.Pages.Approval.ApplySubmitModel
@{ ViewData["Title"] = "提交申请"; }

<div class="page-header">
    <h4><i class="bi bi-file-earmark-plus me-2 text-primary"></i>提交申请</h4>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- 申请表单 -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">新建申请</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">申请类型</label>
                        <select asp-for="ApprovalType" class="form-select" id="applyTypeSelect">
                            <option value="Leave">请假申请</option>
                            <option value="PunchReplenishment">补卡申请</option>
                            <option value="Overtime">加班申请</option>
                            <option value="BusinessTrip">出差申请</option>
                        </select>
                    </div>

                    <!-- 请假字段 -->
                    <div id="leaveFields">
                        <div class="mb-3">
                            <label class="form-label">假期类型</label>
                            <select asp-for="LeaveType" class="form-select">
                                <option value="PersonalLeave">事假</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">开始时间</label>
                            <input asp-for="LeaveStart" type="datetime-local" class="form-control" id="fLeaveStart" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">结束时间</label>
                            <input asp-for="LeaveEnd" type="datetime-local" class="form-control" id="fLeaveEnd" required />
                        </div>
                        <div class="form-text mb-3">开始时间最早只能选到现在往前推24小时以内，最多能提前3个月申请。</div>
                    </div>

                    <!-- 补卡字段 -->
                    <div id="punchFields" class="d-none">
                        <div class="mb-3">
                            <label class="form-label">补卡日期</label>
                            <input asp-for="PunchDate" type="date" class="form-control" id="fPunchDate" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">打卡类型</label>
                            <select asp-for="PunchTypeVal" class="form-select">
                                <option value="ClockIn">上班打卡</option>
                                <option value="ClockOut">下班打卡</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">打卡时间</label>
                            <input asp-for="PunchTime" type="time" class="form-control" />
                        </div>
                    </div>

                    <!-- 加班字段 -->
                    <div id="overtimeFields" class="d-none">
                        <div class="mb-3">
                            <label class="form-label">加班开始</label>
                            <input asp-for="OvertimeStart" type="datetime-local" class="form-control" id="fOvertimeStart" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">加班结束</label>
                            <input asp-for="OvertimeEnd" type="datetime-local" class="form-control" id="fOvertimeEnd" required />
                        </div>
                        <div class="form-text mb-3">只能申请当天的加班，需在当天24点前提交，<strong>一次申请只对应一天的加班，结束时间最晚只能选到明天24点前</strong>（允许跨半夜，但不能一次选出好几天）。<strong>工作日的加班时间不能和当天班次的上下班时间重叠，请只填下班后（或上班前）的加班时段</strong>（休息日、节假日不受此限制）。加班时长按申请的起止时间计算：压到公司统一的饭点时段（中午 12:00-13:00、晚上 17:30-18:00、凌晨 00:00-01:00、早上 5:30-6:00）就扣掉重叠的那部分，按半小时向下取整；不足 0.5 小时不能提交。</div>
                    </div>

                    <!-- 出差字段 -->
                    <div id="businessTripFields" class="d-none">
                        <div class="mb-3">
                            <label class="form-label">出差目的地 <small class="text-muted">（可选）</small></label>
                            <input asp-for="BusinessTripDestination" class="form-control" maxlength="200" placeholder="如：上海分公司" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">出差开始</label>
                            <input asp-for="BusinessTripStart" type="datetime-local" class="form-control" id="fTripStart" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">出差结束</label>
                            <input asp-for="BusinessTripEnd" type="datetime-local" class="form-control" id="fTripEnd" required />
                        </div>
                        <div class="form-text mb-3">审批通过后，出差期间自动记为全勤，无需打卡。开始时间最早只能选到今天0点，最多能提前3个月申请。</div>
                    </div>

                    @if (Model.ApproverOptions.Count > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">审批人 <span class="text-danger">*</span></label>
                            <select asp-for="ApproverUserId" class="form-select" required>
                                <option value="">请选择审批人</option>
                                @foreach (var a in Model.ApproverOptions)
                                {
                                    <option value="@a.UserId">@a.RealName@(string.IsNullOrEmpty(a.Position) ? "" : $"（{a.Position}）")</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-text mb-3">未配置审批人名单，申请将自动提交给您的直属上级审批。</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">申请原因</label>
                        <textarea asp-for="Reason" class="form-control" rows="3" maxlength="1000" placeholder="请填写申请原因..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">附件材料 <small class="text-muted">（可选，最多5个，单文件≤10MB，可逐个添加、单独删除）</small></label>
                        <input id="attachInput" name="Attachments" type="file" class="form-control" multiple
                               accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx" />
                        <div id="fileList" class="mt-2 d-flex flex-wrap gap-2"></div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-send me-2"></i>提交申请
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 我的申请列表 -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">我的申请记录</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>单号</th>
                                <th>类型</th>
                                <th>状态</th>
                                <th>提交时间</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.MyApplications.Any())
                            {
                                <tr><td colspan="5" class="empty-state"><i class="bi bi-inbox"></i>暂无申请记录</td></tr>
                            }
                            @foreach (var item in Model.MyApplications)
                            {
                                <tr>
                                    <td class="small text-muted">@item.RequestNo</td>
                                    <td>@item.ApprovalTypeText</td>
                                    <td>
                                        <span class="badge bg-@BadgeCss(item.ApprovalStatus)">@item.ApprovalStatusText</span>
                                    </td>
                                    <td class="small">@item.SubmittedAt.ToString("MM-dd HH:mm")</td>
                                    <td>
                                        @if (item.ApprovalStatus is AttendanceSystem.Models.Enums.ApprovalStatus.Pending or AttendanceSystem.Models.Enums.ApprovalStatus.InProgress)
                                        {
                                            <form method="post" asp-page-handler="Cancel" class="d-inline"
                                                  onsubmit="return confirm('确认撤销该申请？')">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">撤销</button>
                                            </form>
                                        }
                                        @for (var ai = 0; ai < item.AttachmentUrls.Count; ai++)
                                        {
                                            <a class="btn btn-outline-secondary btn-sm ms-1" href="@item.AttachmentUrls[ai]"
                                               target="_blank" rel="noopener" title="查看附件 @(ai + 1)" aria-label="查看附件 @(ai + 1)">
                                                <i class="bi bi-paperclip"></i>@(ai + 1)
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string BadgeCss(AttendanceSystem.Models.Enums.ApprovalStatus s) => s switch
    {
        AttendanceSystem.Models.Enums.ApprovalStatus.Pending    => "warning text-dark",
        AttendanceSystem.Models.Enums.ApprovalStatus.InProgress => "info text-dark",
        AttendanceSystem.Models.Enums.ApprovalStatus.Approved   => "success",
        AttendanceSystem.Models.Enums.ApprovalStatus.Rejected   => "danger",
        _                                                        => "secondary"
    };
}

@section Scripts {
<script src="~/js/pages/apply-submit.js" asp-append-version="true"></script>
}
