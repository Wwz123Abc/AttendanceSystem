@page
@model AttendanceSystem.Pages.Approval.PendingApprovalModel
@{
    ViewData["Title"] = "待我审批";
    ViewData["AutoRefresh"] = 30;   // 每 30 秒自动刷新待审批列表（弹窗打开时自动暂停）
}

<div class="page-header">
    <h4><i class="bi bi-check2-circle me-2 text-primary"></i>待我审批</h4>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">待审批列表（共 @Model.PendingItems.Count 条）</div>
    <div class="card-body">
        @if (Model.PendingItems.Count > 0)
        {
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <!-- 按申请类型分类的标签：点一下只看这一类，"全部"看所有 -->
                <div class="btn-group" id="typeTabs" role="group">
                    <button type="button" class="btn btn-sm btn-primary" data-type="all">
                        全部 <span class="badge bg-light text-dark ms-1">@Model.PendingItems.Count</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-type="@ApprovalType.PunchReplenishment">
                        补卡 <span class="badge bg-light text-dark ms-1">@Model.PendingItems.Count(i => i.ApprovalType == ApprovalType.PunchReplenishment)</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-type="@ApprovalType.Leave">
                        请假 <span class="badge bg-light text-dark ms-1">@Model.PendingItems.Count(i => i.ApprovalType == ApprovalType.Leave)</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-type="@ApprovalType.Overtime">
                        加班 <span class="badge bg-light text-dark ms-1">@Model.PendingItems.Count(i => i.ApprovalType == ApprovalType.Overtime)</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-type="@ApprovalType.BusinessTrip">
                        出差 <span class="badge bg-light text-dark ms-1">@Model.PendingItems.Count(i => i.ApprovalType == ApprovalType.BusinessTrip)</span>
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small" id="selectedCountText">已选 0 条</span>
                    <button type="button" class="btn btn-success btn-sm" id="batchApproveBtn" disabled
                            data-bs-toggle="modal" data-bs-target="#approveModal" data-action="batch-approve">
                        <i class="bi bi-check2-all me-1"></i>批量通过
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" id="batchRejectBtn" disabled
                            data-bs-toggle="modal" data-bs-target="#approveModal" data-action="batch-reject">
                        批量驳回
                    </button>
                </div>
            </div>
        }
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:36px"><input type="checkbox" id="selectAllCheckbox" disabled="@(Model.PendingItems.Count == 0)"></th>
                        <th>单号</th>
                        <th>申请人</th>
                        <th>部门</th>
                        <th>类型</th>
                        <th>详情</th>
                        <th>提交时间</th>
                        <th>原因</th>
                        <th style="width:180px">操作</th>
                    </tr>
                </thead>
                <tbody id="approvalRows">
                    @if (!Model.PendingItems.Any())
                    {
                        <tr><td colspan="9" class="empty-state"><i class="bi bi-inbox"></i>暂无待审批记录</td></tr>
                    }
                    @foreach (var item in Model.PendingItems)
                    {
                        <tr data-type="@item.ApprovalType">
                            <td><input type="checkbox" class="row-check" value="@item.Id"></td>
                            <td class="small text-muted">@item.RequestNo</td>
                            <td>
                                @item.ApplicantName
                                <span class="text-muted small d-block">@item.ApplicantEmployeeNo</span>
                            </td>
                            <td class="small">@item.DeptName</td>
                            <td><span class="badge bg-secondary">@item.ApprovalTypeText</span></td>
                            <td class="small">@DetailText(item)</td>
                            <td class="small">@item.SubmittedAtText</td>
                            <td class="small text-truncate" style="max-width:120px">@item.Reason</td>
                            <td>
                                <button class="btn btn-outline-info btn-sm me-1"
                                        data-bs-toggle="modal" data-bs-target="#detailModal"
                                        data-id="@item.Id">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-success btn-sm me-1"
                                        data-bs-toggle="modal" data-bs-target="#approveModal"
                                        data-id="@item.Id" data-action="approve">
                                    通过
                                </button>
                                <button class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#approveModal"
                                        data-id="@item.Id" data-action="reject">
                                    驳回
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">我的已审批记录（共 @Model.HandledItems.Count 条）</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>单号</th>
                        <th>申请人</th>
                        <th>部门</th>
                        <th>类型</th>
                        <th>详情</th>
                        <th>提交时间</th>
                        <th>我的处理结果</th>
                        <th>我的处理时间</th>
                        <th>我的审批意见</th>
                        <th>整单当前状态</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.HandledItems.Any())
                    {
                        <tr><td colspan="10" class="empty-state"><i class="bi bi-inbox"></i>暂无已审批记录</td></tr>
                    }
                    @foreach (var item in Model.HandledItems)
                    {
                        var myStep = item.Steps.FirstOrDefault(s => s.ApproverUserId == Model.MyUserId);
                        <tr>
                            <td class="small text-muted">@item.RequestNo</td>
                            <td>
                                @item.ApplicantName
                                <span class="text-muted small d-block">@item.ApplicantEmployeeNo</span>
                            </td>
                            <td class="small">@item.DeptName</td>
                            <td><span class="badge bg-secondary">@item.ApprovalTypeText</span></td>
                            <td class="small">@DetailText(item)</td>
                            <td class="small">@item.SubmittedAtText</td>
                            <td class="small @(myStep?.Status == ApprovalStatus.Rejected ? "text-danger" : "text-success")">@(myStep?.StatusText ?? "—")</td>
                            <td class="small">@(myStep?.HandledAtText ?? "—")</td>
                            <td class="small text-truncate" style="max-width:160px">@(myStep?.Comment ?? "—")</td>
                            <td class="small @item.ApprovalStatusCss">@item.ApprovalStatusText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    /// <summary>按申请类型拼一句简短的"详情"文字，直接显示在列表里，不用点进去才看得到具体时间/时长。</summary>
    string DetailText(ApprovalRequestDto i) => i.ApprovalType switch
    {
        ApprovalType.PunchReplenishment =>
            $"{i.PunchDate:yyyy-MM-dd} {(i.PunchType == PunchType.ClockIn ? "上班卡" : "下班卡")} {i.PunchTime:HH:mm}",
        ApprovalType.Leave =>
            $"{i.LeaveTypeText} {i.LeaveStartTime:yyyy-MM-dd HH:mm} ~ {i.LeaveEndTime:yyyy-MM-dd HH:mm}（{i.LeaveDurationHours:0.#}h）",
        ApprovalType.Overtime =>
            $"{i.OvertimeStartTime:yyyy-MM-dd HH:mm} ~ {i.OvertimeEndTime:yyyy-MM-dd HH:mm}（{i.OvertimeDurationHours:0.#}h）",
        ApprovalType.BusinessTrip =>
            $"{(string.IsNullOrWhiteSpace(i.BusinessTripDestination) ? "" : i.BusinessTripDestination + " ")}{i.BusinessTripStartTime:yyyy-MM-dd} ~ {i.BusinessTripEndTime:yyyy-MM-dd}（{i.BusinessTripDurationDays:0.#}天）",
        _ => "—"
    };
}

<!-- 审批操作 Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="approveModalTitle">审批确认</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <input type="hidden" asp-for="RequestId" id="modalRequestId" />
                    <!-- 批量操作时，JS 会在这里塞入若干个 name="BatchIds" 的隐藏字段（勾选了哪些申请单） -->
                    <div id="batchIdsContainer"></div>
                    <div class="mb-3">
                        <label class="form-label" id="commentLabel">审批意见（可选）</label>
                        <textarea asp-for="Comment" id="commentInput" class="form-control" rows="3" maxlength="1000" placeholder="请填写审批意见..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" id="approveBtn" asp-page-handler="Approve" class="btn btn-success">确认通过</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 详情 Modal -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">申请详情</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailBody">
                <!-- 由 JS 填充 -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const APPROVAL_DETAILS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.PendingItems.ToDictionary(i => i.Id, i => new
    {
        no       = i.RequestNo,
        type     = i.ApprovalTypeText,
        name     = i.ApplicantName,
        empNo    = i.ApplicantEmployeeNo,
        dept     = i.DeptName ?? "",
        reason   = i.Reason ?? "",
        time     = i.SubmittedAtText,
        // 请假
        leaveType  = i.LeaveTypeText ?? "",
        leaveStart = i.LeaveStartTime?.ToString("yyyy-MM-dd HH:mm") ?? "",
        leaveEnd   = i.LeaveEndTime?.ToString("yyyy-MM-dd HH:mm") ?? "",
        leaveHours = i.LeaveDurationHours?.ToString("0.##") ?? "",
        // 补卡
        punchDate  = i.PunchDate?.ToString("yyyy-MM-dd") ?? "",
        punchType  = i.PunchType == AttendanceSystem.Models.Enums.PunchType.ClockIn ? "上班打卡"
                   : i.PunchType == AttendanceSystem.Models.Enums.PunchType.ClockOut ? "下班打卡" : "",
        punchTime  = i.PunchTime?.ToString("HH:mm") ?? "",
        // 加班
        otStart = i.OvertimeStartTime?.ToString("yyyy-MM-dd HH:mm") ?? "",
        otEnd   = i.OvertimeEndTime?.ToString("yyyy-MM-dd HH:mm") ?? "",
        otHours = i.OvertimeDurationHours?.ToString("0.##") ?? "",
        // 出差
        tripDest  = i.BusinessTripDestination ?? "",
        tripStart = i.BusinessTripStartTime?.ToString("yyyy-MM-dd HH:mm") ?? "",
        tripEnd   = i.BusinessTripEndTime?.ToString("yyyy-MM-dd HH:mm") ?? "",
        tripDays  = i.BusinessTripDurationDays?.ToString("0.##") ?? "",
        attachments = i.AttachmentUrls
    })));
</script>
<script src="~/js/pages/pending-approval.js" asp-append-version="true"></script>
}
