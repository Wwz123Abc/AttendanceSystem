@page
@model AttendanceSystem.Pages.Admin.GroupManageModel
@{
    ViewData["Title"] = "考勤组管理";
    // 传给内联 JS 的值一律先序列化成合法的 JS 字面量（引号/反斜杠/换行都会被转义），再由 Razor 做 HTML 属性编码
    string J(object? value) => System.Text.Json.JsonSerializer.Serialize(value);
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h4><i class="bi bi-building me-2 text-primary"></i>考勤组管理</h4>
    <button class="btn btn-primary btn-sm" onclick="openAdd()">
        <i class="bi bi-plus-lg me-1"></i>新建考勤组
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-x-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 table-stack">
            <thead>
                <tr>
                    <th>考勤组名称</th>
                    <th>所属公司</th>
                    <th>所属部门</th>
                    <th>人员数</th>
                    <th>审批人</th>
                    <th>审批层级</th>
                    <th>打卡地点</th>
                    <th>午休/晚餐</th>
                    <th>状态</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (g, cnt) in Model.Groups)
                {
                    var approverIds   = Model.GroupApproverIds.GetValueOrDefault(g.Id) ?? new List<int>();
                    var approverNames = Model.ApproverOptions.Where(u => approverIds.Contains(u.Id)).Select(u => u.RealName).ToList();
                    var deptIds       = Model.GroupDepartmentIds.GetValueOrDefault(g.Id) ?? new List<int>();
                    var deptNames     = Model.DeptTree.Where(d => deptIds.Contains(d.Id)).Select(d => d.Name).ToList();
                    var locations     = Model.GroupLocations.GetValueOrDefault(g.Id) ?? new List<AttendanceSystem.Models.Entities.AttendanceGroupLocation>();
                    <tr>
                        <td data-label="名称" class="fw-semibold">@g.GroupName</td>
                        <td data-label="所属公司" class="small">@(g.CompanyName ?? "-")</td>
                        <td data-label="所属部门" class="small">
                            @if (deptNames.Count > 0)
                            { @string.Join("、", deptNames) }
                            else
                            { <span class="text-muted">未关联</span> }
                        </td>
                        <td data-label="人员数"><span class="badge bg-secondary">@cnt 人</span></td>
                        <td data-label="审批人" class="small">
                            @if (approverNames.Count > 0)
                            { @string.Join("、", approverNames) }
                            else
                            { <span class="text-muted">未配置（默认走直属上级）</span> }
                        </td>
                        <td data-label="审批层级" class="small">
                            <span class="badge @(g.ApprovalLevel == AttendanceSystem.Models.Enums.ApprovalLevelType.Level2 ? "bg-info text-dark" : "bg-light text-dark border")">
                                @g.ApprovalLevel.ToDisplayName()
                            </span>
                        </td>
                        <td data-label="打卡地点" class="small">
                            @if (!g.EnableLocationPunch)
                            {
                                <span class="text-muted">未启用</span>
                            }
                            else if (locations.Count > 0)
                            {
                                <span class="badge bg-success mb-1">已启用</span>
                                <div>@string.Join("、", locations.Select(l => l.LocationName ?? "未命名"))</div>
                            }
                            else
                            {
                                <span class="text-warning">已启用但未配置地点</span>
                            }
                        </td>
                        <td data-label="午休/晚餐" class="small">午休 @g.LunchBreakMinutes 分钟 / 晚餐 @g.DinnerBreakMinutes 分钟</td>
                        <td data-label="状态">
                            @if (g.IsActive)
                            { <span class="badge bg-success">启用</span> }
                            else
                            { <span class="badge bg-secondary">停用</span> }
                        </td>
                        <td class="stack-actions">
                            @* 以前名称用 Replace("'", "\\'") 手工转义，挡不住反斜杠：名称里带 \' 就能闭合字符串、执行任意脚本
                               （2026-09-24 审查修复）。现在每个参数都用 J() 变成 JS 字面量；后三个参数本身是"JSON 文本"，
                               所以是两层序列化：先变成 JSON 文本，再作为 JS 字符串传给 openEdit。 *@
                            <button class="btn btn-outline-primary btn-sm"
                                    onclick="openEdit(@g.Id, @J(g.GroupName),
                                             @(g.EnableLocationPunch ? "true" : "false"),
                                             @g.LunchBreakMinutes, @g.DinnerBreakMinutes,
                                             @J(J(approverIds)),
                                             @J(J(deptIds)),
                                             @J(J(locations.Select(l => new { name = l.LocationName, lat = l.Latitude, lng = l.Longitude, radius = l.RadiusMeters }))),
                                             @J(g.ApprovalLevel.ToString()))">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form method="post" asp-page-handler="Toggle" class="d-inline"
                                  onsubmit="return confirm('@(g.IsActive ? "确认停用该考勤组？" : "确认启用该考勤组？")')">
                                <input type="hidden" name="id" value="@g.Id" />
                                <button type="submit" class="btn btn-sm @(g.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                    <i class="bi bi-@(g.IsActive ? "pause" : "play")"></i>
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Delete" class="d-inline"
                                  onsubmit="return confirm(@J($"确认彻底删除考勤组「{g.GroupName}」？\n\n将会：\n- 组内 {cnt} 名在职员工的考勤组归属会被清空（需另外分配）\n- 跟随本组的部门会解除跟随关系\n- 本组的班次/排班记录、审批人名单、打卡地点会一并删除\n\n此操作不可恢复！"))">
                                <input type="hidden" name="id" value="@g.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Groups.Any())
                {
                    <tr><td colspan="10" class="empty-state"><i class="bi bi-inbox"></i>暂无考勤组</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 新建/编辑 Modal -->
<div class="modal fade" id="groupModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Save" id="groupForm">
                <input type="hidden" asp-for="EditId" id="editId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">新建考勤组</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">考勤组名称 <span class="text-danger">*</span></label>
                            <input asp-for="GroupName" id="fGroupName" class="form-control" required maxlength="100" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">午休时长（分钟）</label>
                            <input asp-for="LunchBreak" id="fLunch" type="number" min="0" max="120" class="form-control" disabled />
                            <div class="form-text text-muted">2026-09-29 起工时计算改成全公司统一按固定时段（12:00-13:00 等）扣减，这里的数值不再影响工时，已停用编辑（仅供查看历史设置）。</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">晚餐时长（分钟）</label>
                            <input asp-for="DinnerBreak" id="fDinner" type="number" min="0" max="120" class="form-control" disabled />
                            <div class="form-text text-muted">同上，不再影响工时计算，已停用编辑。</div>
                        </div>

                        <div class="col-12">
                            <hr class="my-1" />
                            <label class="form-label fw-semibold">
                                所属部门（所属公司）
                                <small class="text-muted fw-normal">（勾选部门 = 长期跟随本组：这些部门现有及以后新增/调入的员工都会自动归入本考勤组；所属公司会按勾选部门自动带出）</small>
                            </label>
                            <div id="deptTreeList" data-dept-tree class="border rounded p-2" style="max-height:260px;overflow-y:auto;">
                                @foreach (var d in Model.DeptTree)
                                {
                                    var linkedGroup = d.AttendanceGroupId.HasValue
                                        ? Model.Groups.FirstOrDefault(x => x.Group.Id == d.AttendanceGroupId.Value).Group?.GroupName
                                        : null;
                                    <div class="form-check" style="padding-left:@(1.5 + d.Depth * 1.2)rem">
                                        <input class="form-check-input dept-checkbox" type="checkbox"
                                               name="SelectedDeptIds" value="@d.Id" id="dept_@d.Id"
                                               data-id="@d.Id" data-parent="@(d.ParentId?.ToString() ?? "")"
                                               onchange="onDeptCheckboxChange(this); filterApprovers();" />
                                        <label class="form-check-label" for="dept_@d.Id">
                                            @d.Name
                                            @if (!string.IsNullOrEmpty(linkedGroup))
                                            { <span class="text-muted small">（当前跟随：@linkedGroup）</span> }
                                        </label>
                                    </div>
                                }
                                @if (!Model.DeptTree.Any())
                                {
                                    <div class="text-muted small">暂无部门，请先到"部门管理"创建部门</div>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <hr class="my-1" />
                            <div class="form-check form-switch">
                                <input asp-for="EnableLocation" id="fEnableLocation" class="form-check-input" type="checkbox"
                                       onchange="toggleLocation(this.checked)" />
                                <label class="form-check-label fw-semibold" for="fEnableLocation">启用定位打卡</label>
                            </div>
                        </div>
                        <div id="locationFields" class="col-12">
                            <label class="form-label fw-semibold">
                                打卡地点 <small class="text-muted fw-normal">（可配多个，员工落在其中任意一个的有效半径内即算打卡成功）</small>
                            </label>
                            <div id="locationSearchBar" class="input-group input-group-sm mb-2" style="display:none">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="search" id="locationSearch" class="form-control" autocomplete="off"
                                       placeholder="按地点名称搜索已添加的地点" oninput="filterLocationRows()" />
                                <span class="input-group-text text-muted" id="locationSearchCount"></span>
                            </div>
                            <div id="locationNoMatch" class="text-muted small mb-2" style="display:none">没有名称匹配的地点</div>
                            <div id="locationRows"></div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="addLocationRow()">
                                <i class="bi bi-plus-lg me-1"></i>添加打卡地点
                            </button>
                        </div>

                        <div class="col-12">
                            <hr class="my-1" />
                            <label class="form-label fw-semibold">
                                审批层级 <span class="text-danger">*</span>
                                <small class="text-muted fw-normal">（一级：只需下面选中的班组长审批；二级：班组长审批通过后，再自动追加申请人自己的"直属上级"审批一次）</small>
                            </label>
                            <div class="d-flex gap-3 mb-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ApprovalLevel" id="fLevel1" value="Level1" checked />
                                    <label class="form-check-label" for="fLevel1">一级审批（班组长）</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ApprovalLevel" id="fLevel2" value="Level2" />
                                    <label class="form-check-label" for="fLevel2">二级审批（班组长 + 直属上级）</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <hr class="my-1" />
                            <label class="form-label fw-semibold">
                                审批人（班组长） <span class="text-danger">*</span>
                                <small class="text-muted fw-normal">（必选，可多选；本组员工提交申请时从这里面选一个人来审批第一级；名单只能选"班组长"角色的人；名单会跟着上面"所属部门"的勾选自动筛选，都不勾则显示全部人选）</small>
                            </label>
                            <div id="approverList" class="border rounded p-2" style="max-height:180px;overflow-y:auto;">
                                @foreach (var u in Model.ApproverOptions)
                                {
                                    var isLegacy = u.Role != Models.Enums.UserRole.TeamLeader;
                                    <div class="form-check" data-dept="@u.DepartmentId">
                                        <input class="form-check-input approver-checkbox" type="checkbox"
                                               name="ApproverUserIds" value="@u.Id" id="approver_@u.Id" />
                                        <label class="form-check-label" for="approver_@u.Id">
                                            @u.RealName <span class="text-muted small">（@(u.Position ?? u.Role.ToDisplayName())）</span>
                                            @if (isLegacy)
                                            { <span class="badge bg-warning text-dark">非班组长·历史配置</span> }
                                        </label>
                                    </div>
                                }
                                @if (!Model.ApproverOptions.Any())
                                {
                                    <div class="text-muted small">暂无可选审批人（需要先有在职的"班组长"角色用户）</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 高德地图选点 Modal：搜地址/在地图上点选/拖动图钉，取代手动查经纬度 -->
<div class="modal fade" id="amapPickerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">地图选点</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="position-relative mb-2">
                    <input type="text" id="amapAddressInput" class="form-control" autocomplete="off"
                           placeholder="输入地址关键字搜索，支持全球任意地点，如：公司总部大楼 / Eiffel Tower" />
                    <div id="amapSearchResults" class="list-group position-absolute w-100 shadow-sm"
                         style="z-index:1060;max-height:240px;overflow:auto;display:none;top:100%"></div>
                </div>
                <div id="amapPickerMap" style="width:100%;height:360px;border:1px solid #dee2e6;border-radius:4px"></div>
                <div class="form-text mt-2">也可以直接在地图上点击，或拖动图钉微调到更精确的位置。境外地点由 OpenStreetMap 提供数据。</div>
                <div id="amapPickerResult" class="mt-2 fw-semibold text-primary"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="confirmAMapPicker()">使用此位置</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@if (Model.AMapEnabled)
{
    <script>window._AMapSecurityConfig = { securityJsCode: '@Model.AMapSecurityCode' };</script>
    <script src="https://webapi.amap.com/maps?v=2.0&key=@Model.AMapJsKey&plugin=AMap.PlaceSearch,AMap.Geocoder"></script>
}
<script>
const AMAP_ENABLED = @Model.AMapEnabled.ToString().ToLower();
</script>
<script src="~/js/pages/group-manage.js" asp-append-version="true"></script>
}
