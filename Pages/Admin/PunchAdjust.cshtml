@page
@model AttendanceSystem.Pages.Admin.PunchAdjustModel
@{ ViewData["Title"] = "手动补卡"; }

<div class="page-header">
    <h4><i class="bi bi-clock-history me-2 text-primary"></i>手动补卡</h4>
</div>
<div class="text-muted small mb-3">管理员权限：可直接为任意员工、任意日期补录/修改打卡时间，保存后立即生效，不需要审批。</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">补录 / 修改打卡</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Adjust">
                    <div class="mb-3 position-relative">
                        <label class="form-label">员工 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="fUserSearch" placeholder="输入姓名或工号搜索" autocomplete="off" required />
                        <input type="hidden" asp-for="UserId" id="fUserId" />
                        <div id="fUserResults" class="list-group position-absolute w-100" style="z-index:1050;display:none;max-height:220px;overflow-y:auto"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">考勤日期 <span class="text-danger">*</span></label>
                        <input asp-for="WorkDate" type="date" class="form-control" id="fWorkDate" required />
                        <div class="form-text">对应"考勤记录"所属的那一天（夜班取上班当天的日期，不是下班那天）。</div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" onclick="loadCurrentRecord()">
                        <i class="bi bi-search me-1"></i>查询当前打卡记录
                    </button>
                    <div id="currentRecordBox" class="alert alert-light border small py-2" style="display:none"></div>

                    <div class="mb-3">
                        <label class="form-label">上班打卡时间</label>
                        <input asp-for="ClockInTime" type="datetime-local" class="form-control" id="fClockIn" />
                        <div class="form-text">留空表示不修改上班打卡时间。</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">下班打卡时间</label>
                        <input asp-for="ClockOutTime" type="datetime-local" class="form-control" id="fClockOut" />
                        <div class="form-text">留空表示不修改下班打卡时间；夜班等跨天班次请把日期部分选到次日。</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">备注 <small class="text-muted">（可选）</small></label>
                        <input asp-for="Remark" class="form-control" maxlength="100" placeholder="如：打卡设备故障，管理员核实后补录" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>保存
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="alert alert-info small mb-0">
            <i class="bi bi-info-circle me-1"></i>
            保存后会按该员工当天排班的班次规则（含午间必打卡窗口）自动重算实际工时和迟到/早退状态，
            口径和员工自己提交"补卡申请"经审批通过后的效果完全一致——区别只是不需要审批，管理员操作即时生效。
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">补卡记录 <span class="text-muted small">（最近 @Model.RecentLog.Count 条管理员手动补卡的操作记录）</span></div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>员工</th>
                        <th>考勤日期</th>
                        <th>上班</th>
                        <th>下班</th>
                        <th>工时(h)</th>
                        <th>备注</th>
                        <th>操作时间</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentLog.Any())
                    {
                        <tr><td colspan="7" class="empty-state"><i class="bi bi-inbox"></i>暂无手动补卡记录</td></tr>
                    }
                    @foreach (var log in Model.RecentLog)
                    {
                        <tr>
                            <td>@log.RealName<span class="text-muted small">（@log.EmployeeNo）</span></td>
                            <td>@log.WorkDate.ToString("yyyy-MM-dd")</td>
                            <td>@log.ClockInText</td>
                            <td>@log.ClockOutText</td>
                            <td>@log.WorkHours.ToString("F1")</td>
                            <td class="small text-muted">@log.Note</td>
                            <td class="small text-muted">@log.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/punch-adjust.js" asp-append-version="true"></script>
}
