@page
@model AttendanceSystem.Pages.Admin.DepartmentManageModel
@{
    ViewData["Title"] = "部门管理";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h4><i class="bi bi-diagram-3 me-2 text-primary"></i>部门管理</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm" onclick="openAdd(null)"><i class="bi bi-plus-lg me-1"></i>添加部门</button>
        <button class="btn btn-outline-secondary btn-sm" onclick="editSelected()"><i class="bi bi-pencil me-1"></i>编辑选中</button>
        <button class="btn btn-outline-danger btn-sm" onclick="deleteSelected()"><i class="bi bi-trash me-1"></i>删除选中</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card">
    <div class="card-header">部门列表（共 @Model.Rows.Count 个）</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width:44px"><input type="checkbox" id="checkAll" onclick="toggleAll(this)" /></th>
                        <th>部门名称</th>
                        <th style="width:110px">成员数<i class="bi bi-info-circle ms-1 text-muted small" title="父部门显示的是含所有下级部门的总人数"></i></th>
                        <th style="width:240px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="4" class="empty-state"><i class="bi bi-inbox"></i>暂无部门，点右上角「添加部门」新建</td></tr>
                    }
                    @foreach (var r in Model.Rows)
                    {
                        <tr data-id="@r.Dept.Id" data-parent="@(r.Dept.ParentId?.ToString() ?? "")"
                            data-name="@r.Dept.DeptName" data-parentid="@(r.Dept.ParentId?.ToString() ?? "")"
                            data-sort="@r.Dept.SortIndex" data-active="@r.Dept.IsActive.ToString().ToLower()"
                            data-haschildren="@r.HasChildren.ToString().ToLower()" data-members="@r.MemberCount"
                            data-devices="@r.DeviceCount"
                            style="@(r.Depth > 0 ? "display:none" : "")">
                            <td><input type="checkbox" class="row-check" value="@r.Dept.Id" /></td>
                            <td>
                                <span style="display:inline-block;width:@(r.Depth * 1.5)rem"></span>
                                @if (r.HasChildren)
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0 me-1 tree-toggle collapsed text-secondary"
                                            onclick="toggleNode(@r.Dept.Id, this)"><i class="bi bi-chevron-right"></i></button>
                                }
                                else
                                {
                                    <span class="me-1" style="display:inline-block;width:1rem"></span>
                                }
                                <i class="bi bi-diagram-3 text-muted me-1"></i>
                                <span class="fw-semibold">@r.Dept.DeptName</span>
                                @if (!r.Dept.IsActive)
                                {
                                    <span class="badge bg-secondary ms-1">停用</span>
                                }
                            </td>
                            <td><span class="badge bg-info-subtle text-info" title="含下级部门的总人数">@r.MemberCount 人</span></td>
                            <td>
                                <button class="btn btn-outline-primary btn-sm me-1" onclick="openEditFromRow(this.closest('tr'))">编辑</button>
                                <button class="btn btn-outline-success btn-sm me-1" onclick="openAdd(@r.Dept.Id)">添加子部门</button>
                                <button class="btn btn-outline-danger btn-sm" onclick="deleteOne(@r.Dept.Id)">删除</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 批量删除用的隐藏表单 -->
<form method="post" asp-page-handler="Delete" id="deleteForm" class="d-none">
    <input type="hidden" name="DeleteIds" id="fDeleteIds" />
</form>

<!-- 新增/编辑 弹窗 -->
<div class="modal fade" id="deptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deptModalTitle">添加部门</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="deptForm">
                <input type="hidden" asp-for="EditId" id="fEditId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">部门名称 <span class="text-danger">*</span></label>
                        <input asp-for="DeptName" class="form-control" id="fDeptName" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">上级部门</label>
                        <select asp-for="ParentId" class="form-select" id="fParentId" data-dept-picker>
                            <option value="">（顶级部门 · 无上级）</option>
                            @foreach (var r in Model.Rows)
                            {
                                <option value="@r.Dept.Id">@(new string('　', r.Depth))@r.Dept.DeptName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">排序（越小越靠前）</label>
                        <input asp-for="SortIndex" type="number" min="0" max="9999" class="form-control" id="fSortIndex" value="0" />
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="fIsActive" />
                        <label class="form-check-label" for="fIsActive">启用</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/department-manage.js" asp-append-version="true"></script>
}
