@page
@model AttendanceSystem.Pages.Admin.ShiftLogModel
@{ ViewData["Title"] = "排班修改记录"; }

<div class="page-header">
    <h4><i class="bi bi-journal-text me-2 text-primary"></i>排班修改记录</h4>
</div>
<div class="text-muted small mb-3">
    每次排班被新增 / 修改（包括"排班管理"的批量排班、新建员工时的排班、转班审批回写）都会在这里留一条记录：
    谁、什么时候、把谁的哪一天、从什么班次改成了什么班次。最多显示最近 1000 条。
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-1">开始日期</label>
        <input type="date" name="from" value="@Model.EffectiveFrom.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">结束日期</label>
        <input type="date" name="to" value="@Model.EffectiveTo.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-1">员工姓名/工号</label>
        <input type="text" name="keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="可留空" />
    </div>
    <div class="col-auto">
        <button class="btn btn-sm btn-primary"><i class="bi bi-search me-1"></i>查询</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>操作时间</th>
                <th>操作人</th>
                <th>工号</th>
                <th>姓名</th>
                <th>考勤日</th>
                <th>原班次</th>
                <th>新班次</th>
                <th>动作</th>
                <th>来源</th>
                <th>备注</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="10" class="text-center text-muted py-4">这段时间没有排班修改记录</td></tr>
        }
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="text-nowrap small">@r.CreatedAt.ToString("MM-dd HH:mm:ss")</td>
                <td class="text-nowrap">@(string.IsNullOrEmpty(r.Operator) ? "（系统）" : r.Operator)</td>
                <td class="text-nowrap">@r.EmployeeNo</td>
                <td class="text-nowrap">@r.RealName</td>
                <td class="text-nowrap">@r.WorkDate.ToString("yyyy-MM-dd")</td>
                <td class="text-nowrap">@(r.OldShift ?? "（无）")</td>
                <td class="text-nowrap">@(r.NewShift ?? "（删除）")</td>
                <td>
                    @if (r.Action == "新增") { <span class="badge bg-success">新增</span> }
                    else if (r.Action == "修改") { <span class="badge bg-warning text-dark">修改</span> }
                    else { <span class="badge bg-secondary">@r.Action</span> }
                </td>
                <td class="text-nowrap small">@r.Source</td>
                <td class="small text-muted">@r.Remark</td>
            </tr>
        }
        </tbody>
    </table>
</div>
