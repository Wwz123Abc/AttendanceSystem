@page
@model AttendanceSystem.Pages.Employee.FaceEnrollModel
@{
    ViewData["Title"] = "人脸信息";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h4><i class="bi bi-person-bounding-box me-2 text-primary"></i>人脸信息</h4>
</div>

<div class="alert alert-info">
    <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i>录入前须知</div>
    <ul class="mb-0 ps-3 small">
        <li>这张照片只用于<b>手机远程打卡</b>时的人脸比对，不做其他用途。</li>
        <li>拍照要求：<b>正对镜头、光线充足、五官清晰、单人</b>；不要戴帽子、口罩、墨镜，不要用美颜/滤镜过重的照片。</li>
        <li>格式：jpg / png / webp，单张不超过 <b>10MB</b>；手机浏览器会直接调用前置摄像头。</li>
        <li>录入成功后一般不能自己更换；换了发型/眼镜影响识别时，请联系管理员在「员工管理」里清除后重录。</li>
        <li>需要先勾选“同意录入本人人脸信息”才能提交。</li>
    </ul>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-image"></i> 当前参考照片
            </div>
            <div class="card-body text-center">
                @if (Model.HasUsablePhoto)
                {
                    <img src="@Model.CurrentPhotoUrl" class="img-fluid rounded" style="max-height:280px" alt="人脸参考照片" />
                    <p class="text-muted small mt-2 mb-0">已录入。如需更换，请联系管理员清除后重新录入</p>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-person-x"></i>@(string.IsNullOrEmpty(Model.CurrentPhotoUrl) ? "还没有录入过人脸信息" : "之前录入的照片文件已经丢失，请在右边重新录入")
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-camera"></i> 录入 / 更新人脸信息
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    这张照片会作为"远程打卡"时人脸识别的比对基准，请正对镜头、光线充足、五官清晰，不要戴口罩/墨镜。
                </p>
                @if (Model.HasUsablePhoto)
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-1"></i>你已经录入过人脸信息，不能自己更换。如需更换（比如换了发型、照片拍得不好），请联系管理员在「员工管理」里清除后重新录入。
                    </div>
                }
                else
                {
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">人脸照片</label>
                        <input type="file" name="FacePhoto" class="form-control" accept="image/*" capture="user" required />
                        <div class="form-text">支持 jpg / png / webp，最大 10MB。手机浏览器会直接调用前置摄像头拍照。</div>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="AgreeConsent" class="form-check-input" type="checkbox" id="agreeConsent" required />
                        <label class="form-check-label" for="agreeConsent">
                            我同意录入本人人脸信息，仅用于打卡身份核验
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload me-2"></i>提交
                    </button>
                    <div class="form-text mt-2">提交成功后会显示绿色提示；如果提示照片不合格，按上面的要求重新拍一张再提交。</div>
                </form>
                }
            </div>
        </div>
    </div>
</div>
