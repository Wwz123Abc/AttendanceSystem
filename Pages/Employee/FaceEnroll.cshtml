@page
@model AttendanceSystem.Pages.Employee.FaceEnrollModel
@{
    ViewData["Title"] = "人脸信息";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h4><i class="bi bi-person-bounding-box me-2 text-primary"></i>人脸信息</h4>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-image"></i> 当前参考照片
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                {
                    <img src="@Model.CurrentPhotoUrl" class="img-fluid rounded" style="max-height:280px" alt="人脸参考照片" />
                    <p class="text-muted small mt-2 mb-0">已录入，重新上传会替换这张</p>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-person-x"></i>还没有录入过人脸信息
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-camera"></i> 录入 / 更新人脸信息
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    这张照片会作为"远程打卡"时人脸识别的比对基准，请正对镜头、光线充足、五官清晰，不要戴口罩/墨镜。
                </p>
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">人脸照片</label>
                        <input type="file" name="FacePhoto" class="form-control" accept="image/*" capture="user" required />
                        <div class="form-text">支持 jpg / png / webp，最大 10MB。手机浏览器会直接调用前置摄像头拍照。</div>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="AgreeConsent" class="form-check-input" type="checkbox" id="agreeConsent" required />
                        <label class="form-check-label" for="agreeConsent">
                            我同意录入本人人脸信息，仅用于打卡身份核验
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload me-2"></i>提交
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
