@page
@model AttendanceSystem.Pages.Attendance.MyRecordModel
@{
    ViewData["Title"] = "我的记录";
    var p = Model.Payroll;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var (curY, curM) = AttendanceSystem.Helpers.PayrollCycle.EndMonthOf(today);
}

<div class="page-header">
    <h4><i class="bi bi-journal-text me-2 text-primary"></i>我的考勤记录</h4>
</div>

<div class="alert alert-info">
    <div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i>怎么看这份记录</div>
    <ul class="mb-0 ps-3 small">
        <li><b>周期</b>：每月 26 日 ~ 次月 25 日算一个薪资周期，上面选的是周期的“结束月份”（选 11 月 = 10-26 ~ 11-25）。</li>
        <li><b>汇总数字</b>：和公司发薪用的“考勤汇总表”是同一套算法，可以放心对照；实到天数、迟到、缺勤、总工时都在上方卡片里。</li>
        <li><b>状态颜色</b>：绿色=正常，黄色=迟到/早退，红色=旷工/缺卡，蓝色=请假/出差。</li>
        <li><b>午间打卡</b>：显示班次要求的午间窗口和实际打卡时间；没打或超出窗口会标红/黄，可能影响当天工时。</li>
        <li><b>发现异常</b>：当天漏打卡的尽快提交补卡申请（普通员工每月最多 3 次）；补卡次数用完或拿不准的，联系文员核对。</li>
    </ul>
</div>

<!-- 月份筛选 -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="d-flex align-items-center gap-3 flex-wrap">
            <label class="fw-semibold mb-0">薪资周期</label>
            <select name="year" class="form-select form-select-sm" style="width:100px">
                @for (int y = curY; y >= curY - 2; y--)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y 年</option>
                }
            </select>
            <select name="month" class="form-select form-select-sm" style="width:90px">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == Model.Month)">@m 月</option>
                }
            </select>
            <span class="text-muted small">每月 26 日 ~ 次月 25 日算一个周期，选的是周期的<b>结束月份</b></span>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class="bi bi-search me-1"></i>查询
            </button>
        </form>
    </div>
</div>

<!-- 周期汇总：数字和"发薪考勤汇总表"同一套算法 -->
<div class="text-muted small mb-2">
    当前周期：@Model.CycleStart.ToString("yyyy-MM-dd") ~ @Model.CycleEnd.ToString("yyyy-MM-dd")（@Model.Month 月薪资周期）
</div>
@{
    var actualDays = p?.ActualWorkdays ?? 0m;
    var lateCount  = p?.LateCount ?? 0;
    var absentDays = p?.AbsentDays ?? 0;
    var payHours   = p?.PayableHours ?? 0m;
    var leaveDays  = p?.LeaveDays ?? 0m;
}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card text-center py-3 stat-card border-start-success">
                <div class="fw-bold text-success fs-4">@actualDays.ToString("0.#")</div>
                <div class="text-muted small">实到天数</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card text-center py-3 stat-card border-start-warning">
                <div class="fw-bold text-warning fs-4">@lateCount</div>
                <div class="text-muted small">迟到次数</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card text-center py-3 stat-card border-start-danger">
                <div class="fw-bold text-danger fs-4">@absentDays</div>
                <div class="text-muted small">缺勤天数</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card text-center py-3 stat-card border-start-info">
                <div class="fw-bold text-info fs-4">@payHours.ToString("F1")</div>
                <div class="text-muted small">总工时(h)</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card text-center py-3">
                <div class="fw-bold fs-4">@leaveDays.ToString("F1")</div>
                <div class="text-muted small">请假天数</div>
            </div>
        </div>
    </div>

<!-- 明细表格 -->
<div class="card">
    <div class="card-header">
        @Model.Month 月薪资周期（@Model.CycleStart.ToString("M月d日") ~ @Model.CycleEnd.ToString("M月d日")）考勤明细（共 @Model.Records.Count 条）
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th title="考勤日（不是打卡机上的时间）">日期</th>
                        <th>星期</th>
                        <th title="当天第一次上班打卡时间；-- 表示没打">上班</th>
                        <th title="当天最后一次下班打卡时间；-- 表示没打">下班</th>
                        <th title="班次要求的午间打卡窗口和实际打卡时间">午间打卡</th>
                        <th title="正常/迟到/早退/旷工/请假/出差等">状态</th>
                        <th title="按公司口径算出的当天工时；-- 表示没有有效打卡">工时(h)</th>
                        <th title="比班次上班时间晚的分钟数">迟到</th>
                        <th title="比班次下班时间早的分钟数">早退</th>
                        <th title="补卡、审批、半天旷工等说明">备注</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Records.Any())
                    {
                        <tr><td colspan="10" class="empty-state"><i class="bi bi-inbox"></i>暂无记录</td></tr>
                    }
                    @foreach (var r in Model.Records)
                    {
                        <!-- r.IsHoliday 目前恒为 false（这个字段全系统都没被赋值过），所以这行"节假日灰底"样式实际上不会生效 -->
                        <tr class="@(r.IsHoliday ? "table-light" : "")">
                            <td>@r.WorkDateText</td>
                            <td>
                                <span class="@(r.WorkDate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "text-danger" : "")">
                                    @r.DayOfWeekText
                                </span>
                            </td>
                            <td class="@(r.ClockInText == "--" ? "text-muted" : "")">@r.ClockInText</td>
                            <td class="@(r.ClockOutText == "--" ? "text-muted" : "")">@r.ClockOutText</td>
                            <td class="small">
                                @if (r.MidCheckHits.Count == 0)
                                {
                                    <span class="text-muted">--</span>
                                }
                                else
                                {
                                    @foreach (var h in r.MidCheckHits)
                                    {
                                        <div class="@(h.IsSatisfied ? "" : h.IsLate ? "text-warning" : "text-danger")"
                                             title="@(h.IsLate ? "超出午间窗口后才打的卡，这一时段按未打卡计算工时" : "")">
                                            @h.WindowStart.ToString("HH:mm")-@h.WindowEnd.ToString("HH:mm")：@(h.HitTime.HasValue ? h.HitTime.Value.ToString("HH:mm") : h.IsLate ? $"迟到（{h.LateTime:HH\\:mm} 打卡，晚了 {h.LateMinutes} 分钟）" : "未打卡")
                                        </div>
                                    }
                                }
                            </td>
                            <td>
                                <span class="badge bg-@StatusColor(r.AttendanceStatus)">@r.StatusText</span>
                                @if (r.LocationAbnormal)
                                {
                                    <i class="bi bi-geo-alt-fill text-danger ms-1"
                                       title="定位异常，管理员正在核实：@(r.LocationAbnormalNote ?? "打卡地点异常")"></i>
                                }
                            </td>
                            <td>@(r.ActualWorkHours > 0 ? r.ActualWorkHours.ToString("F1") : "--")</td>
                            <td class="@(r.LateMinutes > 0 ? "text-danger" : "text-muted")">
                                @(r.LateMinutes > 0 ? $"{r.LateMinutes}分" : "--")
                            </td>
                            <td class="@(r.EarlyLeaveMinutes > 0 ? "text-warning" : "text-muted")">
                                @(r.EarlyLeaveMinutes > 0 ? $"{r.EarlyLeaveMinutes}分" : "--")
                            </td>
                            <td class="text-muted small">@r.ApprovalNote</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        说明：“--”表示当天没有这一项数据（比如没打卡、没迟到）；备注列会显示补卡、审批、半天旷工等说明。
        如果某天确实到岗但记录不对，先看当天有没有打卡记录，再联系文员核对或提交补卡。
    </div>
</div>

@functions {
    string StatusColor(AttendanceSystem.Models.Enums.AttendanceStatus status) => status switch
    {
        AttendanceSystem.Models.Enums.AttendanceStatus.Normal     => "success",
        AttendanceSystem.Models.Enums.AttendanceStatus.Late       => "warning",
        AttendanceSystem.Models.Enums.AttendanceStatus.EarlyLeave => "warning",
        AttendanceSystem.Models.Enums.AttendanceStatus.Absent     => "danger",
        AttendanceSystem.Models.Enums.AttendanceStatus.OnLeave    => "info",
        AttendanceSystem.Models.Enums.AttendanceStatus.Overtime   => "primary",
        AttendanceSystem.Models.Enums.AttendanceStatus.BusinessTrip => "info",
        _                                                          => "secondary"
    };
}
