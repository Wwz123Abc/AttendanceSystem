@page
@model AttendanceSystem.Pages.Attendance.RemotePunchModel
@{
    ViewData["Title"] = "远程打卡";
    var rec = Model.TodayRecord;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h4><i class="bi bi-geo-alt me-2 text-primary"></i>远程打卡</h4>
    <span class="text-muted small">@DateTime.Today.ToString("yyyy年MM月dd日 dddd")</span>
</div>

<div id="wechatWarning" class="alert alert-danger d-none">
    <i class="bi bi-exclamation-triangle me-2"></i>
    检测到你是在微信内置浏览器里打开的——微信对摄像头、定位这两个权限限制比较多，在微信里直接操作大概率会失败。
    请点右上角"<strong>···</strong>"，选择"<strong>在浏览器打开</strong>"（或"在 Safari 中打开"），再重新打卡。
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i>给出差、到不了考勤机的情况用：手机定位 + 现场人脸照片，识别通过才能打卡。正常在公司请用考勤机刷脸。
</div>

@if (!Model.AllowRemotePunch)
{
    <div class="empty-state">
        <i class="bi bi-lock"></i>您暂未开通远程打卡权限，如需使用请联系管理员开通
    </div>
}
else if (!Model.HasFaceReference)
{
    <div class="empty-state">
        <i class="bi bi-person-bounding-box"></i>还没有录入人脸信息
        <div class="mt-2"><a asp-page="/Employee/FaceEnroll" class="btn btn-primary btn-sm">去录入</a></div>
    </div>
}
else
{
    if (Model.ShowMessage)
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
            <i class="bi @(Model.IsSuccess ? "bi-check-circle" : "bi-exclamation-circle") me-2"></i>@Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage) && !Model.ShowMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-2"></i>@Model.ErrorMessage
            @if (Model.ShowFallbackHint)
            {
                <div class="mt-2">
                    识别多次失败的话，也可以改成
                    <a asp-page="/Approval/ApplySubmit" class="alert-link">提交补卡申请</a>，由主管人工审核。
                </div>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div id="locationAlert" class="alert alert-warning d-none">
        <i class="bi bi-geo-alt me-2"></i><span id="locationStatus">正在获取位置...</span>
    </div>
    <div id="cameraAlert" class="alert alert-warning d-none">
        <i class="bi bi-camera-video-off me-2"></i><span id="cameraStatus">正在打开摄像头...</span>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-fingerprint"></i> 今日打卡
                </div>
                <div class="card-body text-center py-4">
                    <div class="mb-3">
                        <span class="display-4 fw-bold text-primary" id="currentTime">--:--:--</span>
                        <div class="text-muted small mt-1">当前时间</div>
                    </div>

                    <div id="locationInfo" class="mb-3 small text-muted d-none">
                        <i class="bi bi-geo-alt-fill text-success me-1"></i>
                        <span id="locationText">位置已获取</span>
                    </div>

                    <div class="mb-3 position-relative d-inline-block">
                        <video id="cameraPreview" autoplay playsinline muted
                               style="width:220px;height:220px;object-fit:cover;border-radius:12px;background:#000;transform:scaleX(-1)"></video>
                        <canvas id="captureCanvas" style="display:none"></canvas>
                        <div id="cameraReadyBadge" class="badge bg-success position-absolute top-0 start-0 m-2 d-none">
                            <i class="bi bi-camera-video"></i> 摄像头已就绪
                        </div>
                    </div>
                    <div class="text-muted small mb-3">点击下面的按钮打卡时会自动拍下当前画面识别，不用手动拍照</div>

                    <form method="post" id="punchForm">
                        <input type="hidden" asp-for="Latitude" id="lat" />
                        <input type="hidden" asp-for="Longitude" id="lng" />
                        <input type="hidden" asp-for="Accuracy" id="accuracy" />
                        <input type="hidden" asp-for="CapturedPhotoData" id="capturedPhotoData" />

                        <div class="d-flex justify-content-center mt-3">
                            <button type="button" id="punchBtn" class="btn btn-primary btn-lg px-5" onclick="submitPunch()">
                                <i class="bi bi-fingerprint me-2"></i>打卡
                            </button>
                        </div>
                        <div class="text-muted small mt-2">
                            系统自动判断：还没打过卡算上班；快到下班时间了算下班；中间时段再打卡只留识别记录，不影响上下班状态
                        </div>
                    </form>

                    @if (rec?.ClockInTime != null)
                    {
                        <div class="mt-3 text-success small">
                            <i class="bi bi-check-circle me-1"></i>上班已打卡：@rec.ClockInTime?.ToString("HH:mm")
                        </div>
                    }
                    @if (rec?.ClockOutTime != null)
                    {
                        <div class="text-warning small">
                            <i class="bi bi-check-circle me-1"></i>下班已打卡：@rec.ClockOutTime?.ToString("HH:mm")
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle"></i> 今日考勤状态
                </div>
                <div class="card-body">
                    @if (rec != null)
                    {
                        <dl class="row mb-0">
                            <dt class="col-4 text-muted fw-normal">状态</dt>
                            <dd class="col-8"><span class="badge bg-@StatusColor(rec.AttendanceStatus) fs-6">@rec.StatusText</span></dd>
                            <dt class="col-4 text-muted fw-normal">上班时间</dt>
                            <dd class="col-8 fw-semibold">@rec.ClockInText</dd>
                            <dt class="col-4 text-muted fw-normal">下班时间</dt>
                            <dd class="col-8 fw-semibold">@rec.ClockOutText</dd>
                            <dt class="col-4 text-muted fw-normal">实际工时</dt>
                            <dd class="col-8">@(rec.ActualWorkHours > 0 ? $"{rec.ActualWorkHours:F1} 小时" : "--")</dd>
                            @if (rec.LateMinutes > 0)
                            {
                                <dt class="col-4 text-muted fw-normal">迟到</dt>
                                <dd class="col-8 text-danger">@rec.LateMinutes 分钟</dd>
                            }
                            @if (rec.EarlyLeaveMinutes > 0)
                            {
                                <dt class="col-4 text-muted fw-normal">早退</dt>
                                <dd class="col-8 text-warning">@rec.EarlyLeaveMinutes 分钟</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-clock"></i>今日暂无打卡记录
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@functions {
    string StatusColor(AttendanceSystem.Models.Enums.AttendanceStatus status) => status switch
    {
        AttendanceSystem.Models.Enums.AttendanceStatus.Normal       => "success",
        AttendanceSystem.Models.Enums.AttendanceStatus.Late         => "warning",
        AttendanceSystem.Models.Enums.AttendanceStatus.EarlyLeave   => "warning",
        AttendanceSystem.Models.Enums.AttendanceStatus.Absent       => "danger",
        AttendanceSystem.Models.Enums.AttendanceStatus.OnLeave      => "info",
        AttendanceSystem.Models.Enums.AttendanceStatus.Overtime     => "primary",
        AttendanceSystem.Models.Enums.AttendanceStatus.BusinessTrip => "info",
        _                                                            => "secondary"
    };
}

@section Scripts {
<script src="~/js/pages/remote-punch.js" asp-append-version="true"></script>
}
